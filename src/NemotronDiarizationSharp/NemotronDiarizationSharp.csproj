<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NemotronDiarizationSharp</AssemblyName>
    <RootNamespace>NemotronDiarizationSharp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Description>Managed .NET 10 SDK for speaker diarization through the NeMo-Speech.cpp C ABI. Applications must separately deploy and explicitly select a compatible CPU or CUDA native runtime; this package contains no native binaries. Backend and platform validation are separate, and the SDK does not automatically fall back between backends.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
