<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>NemotronDiarizationSharp</AssemblyName>
    <RootNamespace>NemotronDiarizationSharp</RootNamespace>
    <Copyright>Copyright (c) 2026 Gargulz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Description>Managed .NET 10 SDK for speaker diarization through the NeMo-Speech.cpp C ABI. Applications install a separate CPU or CUDA runtime package; the SDK package contains no native binaries. Auto prefers CUDA when a staged runtime and NVIDIA device are discoverable, otherwise it uses CPU when available. Runtime selection is fixed per process.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>diarization;speaker-diarization;nemotron;nemo;dotnet</PackageTags>
    <PackageReleaseNotes>MIT applies to original project-owned SDK source. Inference requires separately obtained compatible native components and a model, each subject to its own terms.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\docs\distribution\DISTRIBUTION_STATUS.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
