<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>NemotronDiarizationSharp.AllRuntimes</PackageId>
    <Version>1.0.0</Version>
    <Description>Convenience metapackage for the managed SDK and its locally validated CPU and CUDA Windows x64 runtime packages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>diarization;nemotron;nemo;cpu;cuda;win-x64</PackageTags>
    <PackageReleaseNotes>Dependency-only package referencing the SDK and both Windows x64 runtimes. Runtime packages have not been published; their third-party redistribution review remains incomplete.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- A dependency-only metapackage intentionally has no compile-time assembly. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <!--
    Ordinary solution restore/build must not depend on unpublished packages.
    Enable these package references only for the separate aggregation-package workflow.
  -->
  <ItemGroup Condition="'$(EnableAllRuntimesPackageDependencies)' == 'true'">
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\distribution\DISTRIBUTION_STATUS.md" Pack="true" PackagePath="" />
    <PackageReference Include="NemotronDiarizationSharp" Version="$(Version)" />
    <PackageReference Include="NemotronDiarizationSharp.Runtime.Cpu" Version="$(Version)" />
    <PackageReference Include="NemotronDiarizationSharp.Runtime.Cuda" Version="$(Version)" />
  </ItemGroup>

  <Target Name="ValidateAllRuntimesPackageDependencies" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(EnableAllRuntimesPackageDependencies)' != 'true'"
           Text="Packing AllRuntimes requires -p:EnableAllRuntimesPackageDependencies=true and a package source containing the matching SDK, CPU runtime, and CUDA runtime packages." />
  </Target>

  <Target Name="KeepAllRuntimesAsMetaPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <Content Remove="@(Content)" />
    </ItemGroup>
  </Target>
</Project>
