<Project>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\nemotron\cpu\win-x64\native\nemo_speech_asr_c.dll')">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\nemotron\cpu\win-x64\native\**\*">
      <Link>runtimes\nemotron\cpu\win-x64\native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
