<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>NemotronDiarizationSharp.Runtime.Cpu</AssemblyName>
    <RootNamespace>NemotronDiarizationSharp.Runtime.Cpu</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>NemotronDiarizationSharp.Runtime.Cpu</PackageId>
    <Description>Windows x64 CPU runtime assets for NVIDIA NeMo-Speech.cpp v0.2.0, used by the independent NemotronDiarizationSharp wrapper.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>diarization;nemotron;nemo;native;cpu;win-x64</PackageTags>
    <PackageReleaseNotes>Windows x64 CPU runtime assets. A compatible Visual C++ x64 runtime is required. Native runtime packages have not been published; third-party binary redistribution review remains incomplete. See DISTRIBUTION_STATUS.md.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="runtimes\win-x64\native\concrt140.dll" />
    <None Remove="runtimes\win-x64\native\ggml-base.dll" />
    <None Remove="runtimes\win-x64\native\ggml-cpu.dll" />
    <None Remove="runtimes\win-x64\native\ggml.dll" />
    <None Remove="runtimes\win-x64\native\llama.dll" />
    <None Remove="runtimes\win-x64\native\msvcp140.dll" />
    <None Remove="runtimes\win-x64\native\msvcp140_1.dll" />
    <None Remove="runtimes\win-x64\native\msvcp140_2.dll" />
    <None Remove="runtimes\win-x64\native\msvcp140_atomic_wait.dll" />
    <None Remove="runtimes\win-x64\native\msvcp140_codecvt_ids.dll" />
    <None Remove="runtimes\win-x64\native\nemo_speech_asr.dll" />
    <None Remove="runtimes\win-x64\native\nemo_speech_asr_c.dll" />
    <None Remove="runtimes\win-x64\native\nemo_speech_nmt.dll" />
    <None Remove="runtimes\win-x64\native\nemo_speech_nmt_c.dll" />
    <None Remove="runtimes\win-x64\native\nemo_speech_tts.dll" />
    <None Remove="runtimes\win-x64\native\vcomp140.dll" />
    <None Remove="runtimes\win-x64\native\vcruntime140.dll" />
    <None Remove="runtimes\win-x64\native\vcruntime140_1.dll" />
    <Content Include="runtimes\win-x64\native\nemo_speech_asr_c.dll" Pack="true" PackagePath="runtimes\nemotron\cpu\win-x64\native\" />
    <Content Include="runtimes\win-x64\native\nemo_speech_asr.dll" Pack="true" PackagePath="runtimes\nemotron\cpu\win-x64\native\" />
    <Content Include="runtimes\win-x64\native\ggml.dll" Pack="true" PackagePath="runtimes\nemotron\cpu\win-x64\native\" />
    <Content Include="runtimes\win-x64\native\ggml-base.dll" Pack="true" PackagePath="runtimes\nemotron\cpu\win-x64\native\" />
    <Content Include="runtimes\win-x64\native\ggml-cpu.dll" Pack="true" PackagePath="runtimes\nemotron\cpu\win-x64\native\" />
    <None Update="buildTransitive\NemotronDiarizationSharp.Runtime.Cpu.targets" Pack="true" PackagePath="buildTransitive\NemotronDiarizationSharp.Runtime.Cpu.targets" />
    <None Update="licenses\**\*" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\docs\distribution\DISTRIBUTION_STATUS.md" Pack="true" PackagePath="" />
    <None Include="..\..\docs\distribution\licenses\DARTS_CLONE_LICENSE.txt" Pack="true" PackagePath="licenses\third_party\darts-clone\LICENSE" />
    <None Include="..\..\docs\distribution\licenses\GGML_FILE_NOTICES.txt" Pack="true" PackagePath="licenses\third_party\ggml\FILE_NOTICES.txt" />
    <None Update="cpu-runtime-manifest.json" Pack="true" PackagePath="provenance\cpu-runtime-manifest.json" />
  </ItemGroup>
</Project>
