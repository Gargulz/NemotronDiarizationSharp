<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyName>NemotronDiarizationSharp.Runtime.Cuda</AssemblyName>
    <RootNamespace>NemotronDiarizationSharp.Runtime.Cuda</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>NemotronDiarizationSharp.Runtime.Cuda</PackageId>
    <Description>Windows x64 CUDA runtime assets for NVIDIA NeMo-Speech.cpp v0.2.0, used by the independent NemotronDiarizationSharp wrapper.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>diarization;nemotron;nemo;native;cuda;win-x64</PackageTags>
    <PackageReleaseNotes>Windows x64 CUDA runtime assets. NVIDIA and Microsoft components retain separate terms. Native runtime packages have not been published; third-party binary redistribution review remains incomplete. See DISTRIBUTION_STATUS.md.</PackageReleaseNotes>
    <RuntimeSourceDirectory Condition="'$(RuntimeSourceDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\local\runtimes\cuda-v0.2.0</RuntimeSourceDirectory>
    <RuntimeSourceDirectory>$([System.IO.Path]::GetFullPath('$(RuntimeSourceDirectory)'))</RuntimeSourceDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(RuntimeSourceDirectory)\*.dll" Pack="true" PackagePath="runtimes\nemotron\cuda\win-x64\native\" />
    <None Include="buildTransitive\NemotronDiarizationSharp.Runtime.Cuda.targets" Pack="true" PackagePath="buildTransitive\NemotronDiarizationSharp.Runtime.Cuda.targets" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\NemotronDiarizationSharp.Runtime.Cpu\licenses\**\*" Pack="true" PackagePath="licenses\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\docs\distribution\licenses\DARTS_CLONE_LICENSE.txt" Pack="true" PackagePath="licenses\third_party\darts-clone\LICENSE" />
    <None Include="..\..\docs\distribution\licenses\GGML_FILE_NOTICES.txt" Pack="true" PackagePath="licenses\third_party\ggml\FILE_NOTICES.txt" />
    <None Include="..\..\docs\distribution\licenses\CUDA-12.9.1-EULA.txt" Pack="true" PackagePath="licenses\nvidia\CUDA-12.9.1-EULA.txt" />
    <None Include="..\..\docs\distribution\DISTRIBUTION_STATUS.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="ValidateCudaRuntimeSourceDirectory" BeforeTargets="Pack">
    <Error Condition="!$([System.IO.Path]::IsPathFullyQualified('$(RuntimeSourceDirectory)'))"
           Text="RuntimeSourceDirectory must be an absolute directory. Set -p:RuntimeSourceDirectory=&lt;absolute path to the staged CUDA DLLs&gt;." />
    <Error Condition="!Exists('$(RuntimeSourceDirectory)\nemo_speech_asr_c.dll')"
           Text="RuntimeSourceDirectory '$(RuntimeSourceDirectory)' does not contain nemo_speech_asr_c.dll." />
    <Error Condition="'@(Content->Count())' == '0'"
           Text="RuntimeSourceDirectory '$(RuntimeSourceDirectory)' does not contain any CUDA runtime DLLs." />
  </Target>
</Project>
